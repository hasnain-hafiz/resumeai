# Copy to .env and fill in real values. Never commit the real .env file.

# --- Database (Neon Postgres in prod, local Postgres in dev) ---
DB_URL=jdbc:postgresql://localhost:5432/resumeai
DB_USERNAME=resumeai
DB_PASSWORD=resumeai

# --- Redis (Upstash in prod, local Redis in dev) ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# --- JWT ---
# Generate with: openssl rand -base64 48
JWT_SECRET=

# --- Google OAuth2 ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- SMTP (e.g. Resend, SendGrid, Postmark) ---
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM=ResumeAI <no-reply@resumeai.app>

# --- Frontend URLs (used for email links + OAuth redirect) ---
FRONTEND_BASE_URL=http://localhost:5173
FRONTEND_OAUTH_REDIRECT_URL=http://localhost:5173/oauth/callback
CORS_ALLOWED_ORIGINS=http://localhost:5173

PORT=8080
